#!/usr/bin/env python3

###############################################################################
# Sunswift High Level DDS Package generator
# Author: Ryan Wong
#
# Creates a new package according to this structure in the directory which you
# run this script from
#
# <package_name>/
#     .srpkg
#     src/
#     include/
#     test/
#     param/
#     CMakeLists.txt
#     README.md
#
# src -> all your .cpp files
# include -> all your .hpp files
# test -> all your test files
# param -> files for static params
#
# Usage in directory you want to create package in:
#   - srpkg create <name> [--linux | --qnx]
# Usage from anywhere in repository
#   - srpkg info <name>
#   - srpkg list
###############################################################################

import argparse
import re
import shutil
from typing import Optional
from datetime import datetime
from pathlib import Path
from dataclasses import dataclass
from common_helpers import resolve_repo_root, validate_repo_root, die, COMPILER_QNX_FLAG, COMPILER_LINUX_FLAG

# =================================================================================================
# CONSTANTS
# =================================================================================================
CWD = Path.cwd().resolve()

# All of these are relative to pkg top level
NESTED_DIRS = {
    "src": "src",
    "include": "include",
    "param": "param",
    "test": "test"
}
FILES = {
    "metadata": ".srpkg",
    "make": "CMakeLists.txt",
    "readme": "README.md",
    "param": "param/{pkg_name}_param.toml",
    "main": "src/main.cpp"
}

@dataclass
class PkgPaths:
    pkg_name: str
    abs_pkg_path: Path

# =================================================================================================
# HELPERS
# =================================================================================================

def dir_size(path: Path) -> int:
    return sum(
        p.stat().st_size
        for p in path.rglob("*")
        if p.is_file()
    )

def fill_readme(paths: PkgPaths, target: str) -> None:
    text = f"""# {paths.pkg_name} DDS Package
Target: {target}

## Description
Briefly describe the purpose of this DDS node.

## Topics Published to
Enter topics published to below
Topic | Topic Type | Description
------|----------|------------
/domain/subsystem/topic|`Topic Type`|BMS Voltage

## Topics Subscribed to
Enter topics subscribed to below
Topic | Topic Type | Description
------|----------|------------
/domain/subsystem/topic|`Topic Type`|BMS Voltage

## Parameters
Under construction!

## Contributors
Written by `Your name here` | `Your zID here`"""
    with (paths.abs_pkg_path / FILES["readme"]).open("w") as file:
        file.write(text)

def fill_cmakelists(paths: PkgPaths, target: str) -> None:
    # Guard flag is the opposing platform: a Linux package skips when SR_TARGET_QNX is set, and vice versa
    guard_flag = COMPILER_QNX_FLAG if target == "LINUX" else COMPILER_LINUX_FLAG
    text = f"""if({guard_flag})
    return()
endif()

# Per-node info
set(TARGET_NAME {paths.pkg_name})
set(SOURCES
    src/main.cpp
    # Add your sources here
)
set(INCLUDE_DIRS
    include
)
set (LIBS
    sr_node
    # add your type libraries here
    # add other dependencies here
)

# Compile and link
add_executable(${{TARGET_NAME}} ${{SOURCES}})
target_include_directories(${{TARGET_NAME}} PRIVATE ${{INCLUDE_DIRS}})
target_link_libraries(${{TARGET_NAME}} PRIVATE ${{LIBS}})

# Install time
sr_install_node(${{TARGET_NAME}} param/${{TARGET_NAME}}_param.toml)
"""
    with (paths.abs_pkg_path / FILES["make"]).open("w") as file:
        file.write(text)

def fill_param(paths: PkgPaths) -> None:
    text = f"""# {paths.pkg_name}_param.toml
# Parameter file for {paths.pkg_name}
# All parameters are optional. Missing keys fall back to declared defaults in the node.
# Undeclared parameters are ignored

[params]
# example_string = "hello"
# example_int    = 42
# example_float  = 3.14
# example_bool   = true

"""
    with (paths.abs_pkg_path / FILES["param"].format(pkg_name=paths.pkg_name)).open("w") as file:
        file.write(text)

def fill_main(paths: PkgPaths) -> None:
    text = f"""// #include "my_node.hpp" TODO: change to your node

int main(int argc, char* argv[]) {{
    // TODO: initialise SRNode
    // TODO: Spin SRNode and catch exceptions
    return 0;
}}

"""
    with (paths.abs_pkg_path / FILES["main"]).open("w") as file:
        file.write(text)

def pkg_exist_elsewhere(paths: PkgPaths, repo_root: Path) -> Optional[Path]:
    """Recursively search src/ for a package with the same name.

    Returns the path relative to repo_root if found, None otherwise.
    """
    src_path = repo_root / "src"
    for path in src_path.rglob(paths.pkg_name):
        if path.is_dir() and (path / FILES["metadata"]).exists():
            return path.relative_to(repo_root)
    return None

def safe_rmdir(paths: PkgPaths, repo_root: Path) -> None:
    """Verify every safety condition then delete the package directory.
    """
    if not paths.abs_pkg_path.exists():
        die("Delete: Path does not exist")

    if not paths.abs_pkg_path.is_dir():
        die("Delete: Path is not a directory")

    if not (paths.abs_pkg_path / FILES["metadata"]).exists():
        die("Delete: Path is not a Sunswift Package")

    if paths.abs_pkg_path.is_symlink():
        die("Delete: Path is a symlink")

    try:
        paths.abs_pkg_path.relative_to(repo_root)
    except ValueError:
        die("Delete: Path is not within repository")

    if (paths.abs_pkg_path == repo_root or
            paths.abs_pkg_path == Path("/") or
            paths.abs_pkg_path == repo_root / "src"):
        die("wtf are u doing man")

    shutil.rmtree(paths.abs_pkg_path)

def validate_name(name: str) -> PkgPaths:
    pattern = r"^[a-z0-9_]+$"
    if not re.match(pattern, name):
        die("Invalid package name: must be in 'snake_case'")
    return PkgPaths(name, CWD / name)

# =================================================================================================
# CORE LOGIC
# =================================================================================================

def parse_args() -> argparse.Namespace:
    """Build the CLI parser and return parsed arguments."""
    root_parser = argparse.ArgumentParser(
        description="Sunswift DDS package management tool. "
                    "Packages are created in your current working directory."
    )
    level1_junction = root_parser.add_subparsers(dest="command", required=True)
    command_create = level1_junction.add_parser("create")
    command_info = level1_junction.add_parser("info")
    level1_junction.add_parser("list")
    command_create.add_argument("name", help="Name of package to create (snake_case)")
    target_group = command_create.add_mutually_exclusive_group()
    target_group.add_argument("--linux", action="store_true", help="Package to target Linux")
    target_group.add_argument("--qnx", action="store_true", help="Package to target QNX")
    command_info.add_argument("name", help="Name of package to get info on")

    return root_parser.parse_args()

def mkdir_package(paths: PkgPaths) -> None:
    """Create the package directory tree and empty files."""
    paths.abs_pkg_path.mkdir()
    for dir in NESTED_DIRS.values():
        (paths.abs_pkg_path / dir).mkdir()
    for file in FILES.values():
        new_file = file
        if "{pkg_name}" in file:
            new_file = file.format(pkg_name=paths.pkg_name)
        (paths.abs_pkg_path / new_file).touch()

def pkg_create(paths: PkgPaths, repo_root: Path, target: str) -> None:
    """Create a new package in CWD if no name conflict exists under src/.

    Args:
        paths: Package name and absolute destination path.
        repo_root: Root of the Sunswift repository.
        target: Build target platform, either "QNX" or "LINUX".
    """
    try:
        CWD.relative_to(repo_root / "src")
    except ValueError:
        die("Error: Packages must be created in src/")    
    
    if paths.abs_pkg_path.exists():
        die(f"Error: {paths.pkg_name} already exists at '{paths.abs_pkg_path}'")

    location = pkg_exist_elsewhere(paths, repo_root)
    if location is not None:
        die(f"Error: {paths.pkg_name} already exists at '{location}'")

    try:
        mkdir_package(paths)
        fill_readme(paths, target)
        fill_cmakelists(paths, target)
        fill_param(paths)
        fill_main(paths)
    except Exception as e:
        if paths.abs_pkg_path.exists():
            safe_rmdir(paths, repo_root)
        die(f"Error creating package: {e}")

    print(f"Package '{paths.pkg_name}' created successfully!")
    print(f"Location: {paths.abs_pkg_path}\n")

    print("Created structure:")
    for dir in NESTED_DIRS.values():
        print(f"  {dir}")
    for file_name in FILES.values():
        if "{pkg_name}" in file_name:
            file_name = file_name.format(pkg_name=paths.pkg_name)
        print(f"  {file_name}")

def pkg_info(paths: PkgPaths, repo_root: Path) -> None:
    """Print metadata and file listing for a package found under src/.

    Args:
        paths: Package name and absolute destination path.
        repo_root: Root of the Sunswift repository.
    """
    location = pkg_exist_elsewhere(paths, repo_root)

    if location is None:
        die(f"Package: '{paths.pkg_name}' not found in src/")
        return

    abs_path = repo_root / location
    size_bytes = dir_size(abs_path)
    size_kb = size_bytes / 1024
    num_files = sum(1 for thing in abs_path.rglob("*") if thing.is_file())
    num_dirs = sum(1 for thing in abs_path.rglob("*") if thing.is_dir())

    all_files = list(abs_path.rglob("*"))
    if all_files:
        creation_ts = min(p.stat().st_ctime for p in all_files)
        last_mod_ts = max(p.stat().st_mtime for p in all_files)
    else:
        creation_ts = last_mod_ts = abs_path.stat().st_ctime

    creation_date = datetime.fromtimestamp(creation_ts).strftime("%d/%m/%Y %H:%M:%S")
    last_mod_date = datetime.fromtimestamp(last_mod_ts).strftime("%d/%m/%Y %H:%M:%S")

    print(f"=============== {paths.pkg_name} INFO ===============")
    print(f"Package: '{paths.pkg_name}'")
    print(f"Location: {location}")
    print(f"Total size: {size_bytes} B ({size_kb:.2f} KB)")
    print(f"Contents: {num_dirs} directories, {num_files} files")
    print(f"Created: {creation_date}")
    print(f"Last modified: {last_mod_date}")

    src_dir = abs_path / "src"
    if src_dir.exists():
        cpp_files = sorted([f.relative_to(abs_path) for f in src_dir.rglob("*.cpp")])
        if cpp_files:
            print("\nSource files (.cpp):")
            for f in cpp_files:
                print(f"  {f}")

    include_dir = abs_path / "include"
    if include_dir.exists():
        hpp_files = sorted([f.relative_to(abs_path) for f in include_dir.rglob("*.hpp")])
        if hpp_files:
            print("\nHeader files (.hpp):")
            for f in hpp_files:
                print(f"  {f}")

def pkg_list(repo_root: Path) -> None:
    """List all valid packages under src/, identified by the .srpkg marker.

    Args:
        repo_root: Root of the Sunswift repository.
    """
    src_root = repo_root / "src"
    if not src_root.exists():
        die("No src/ directory found in repository.")

    packages = []
    for path in src_root.rglob("*"):
        if path.is_dir() and (path / FILES["metadata"]).exists():
            packages.append((path.name, path.relative_to(repo_root)))

    print("=============== NODE LIST ===============")
    if not packages:
        print("No packages found in src/")
        return

    max_name_len = max(len(name) for name, _ in packages) + 2
    print(f"Found {len(packages)} package(s) in src/:\n")
    for name, rel_path in packages:
        print(f"  {name.ljust(max_name_len)} : {rel_path}")


# =================================================================================================
# MAIN
# =================================================================================================
def main():
    args = parse_args()

    repo_root = Path()
    try:
        repo_root = resolve_repo_root(CWD)
        validate_repo_root(repo_root)
    except Exception as exc:
        die(str(exc))

    cmd = args.command
    if cmd == "create":
        target = "LINUX" if args.linux else "QNX"
        paths = validate_name(args.name)
        pkg_create(paths, repo_root, target)
    elif cmd == "info":
        paths = validate_name(args.name)
        pkg_info(paths, repo_root)
    elif cmd == "list":
        pkg_list(repo_root)


if __name__ == "__main__":
    main()
